{
  "rules": {
    "mouzas": {
      ".read": true,
      ".write": "auth != null"
    },
    "users": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$uid": {
        ".read": true,
        "deviceId": {
          ".write": "auth != null || !data.exists() || data.val() == ''"
        },
        "deviceInfo": {
          ".write": "auth != null || !data.exists() || data.val() == ''"
        },
        "lastSeen": {
          ".write": true
        }
      }
    }
  }
}